#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

smoke_root="$(mktemp -d)"
log_file="$smoke_root/log"
trap 'rm -rf "$smoke_root"' EXIT

status=0
timeout 25s env \
  -u DISPLAY \
  -u WAYLAND_DISPLAY \
  -u GTK_THEME \
  -u QT_QPA_PLATFORMTHEME \
  -u QT_STYLE_OVERRIDE \
  COUCH_SHELL_AUTH_FILE="$smoke_root/auth.json" \
  QT_QPA_PLATFORM=offscreen \
  QSG_RHI_BACKEND=software \
  bash ./scripts/with-qml-env \
  quickshell \
  -p "$repo_root/smoke.qml" \
  --no-color \
  -v >"$log_file" 2>&1 || status=$?

if grep -Fq "COUCH_SHELL_SMOKE_FAILURE:" "$log_file" || ! grep -Fq "COUCH_SHELL_SMOKE_OK" "$log_file"; then
  cat "$log_file"
  exit 1
fi

case "$status" in
  0)
    exit 0
    ;;
  *)
    cat "$log_file"
    exit "$status"
    ;;
esac
