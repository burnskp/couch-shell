#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

search_paths=(shell.qml lock.qml smoke.qml animations components modules services theme ui/ShellMarkdownText.qml tests/qml tests/smoke)
existing_paths=()

for path in "${search_paths[@]}"; do
  if [[ -e "$path" ]]; then
    existing_paths+=("$path")
  fi
done

mapfile -t qml_files < <(find "${existing_paths[@]}" -type f -name '*.qml' | sort)

if [[ ${#qml_files[@]} -eq 0 ]]; then
  echo "No QML files found to lint."
  exit 0
fi

qml_import_path="$(bash ./scripts/with-qml-env bash -lc 'printf %s "$QML_IMPORT_PATH"')"
import_args=()

if [[ -n "$qml_import_path" ]]; then
  IFS=':' read -r -a import_paths <<< "$qml_import_path"

  for import_path in "${import_paths[@]}"; do
    [[ -n "$import_path" ]] && import_args+=("-I" "$import_path")
  done
fi

bash ./scripts/with-qml-env \
  qmllint \
  --ignore-settings \
  -W 0 \
  --multiline-strings warning \
  --unused-imports warning \
  "${import_args[@]}" \
  "${qml_files[@]}"
